@startuml
title Поведенческая UML: создание брони
start
:Получить POST /bookings/create;
:Распарсить JSON или form body;
:Проверить room_id и даты;
if (Данные корректны?) then (нет)
  :Вернуть 400 {error};
  stop
else (да)
  :Начать транзакцию;
  :Заблокировать строку номера;
  if (Номер существует?) then (нет)
    :Откатить транзакцию;
    :Вернуть 404 {error};
    stop
  else (да)
    :Найти пересекающиеся брони;
    if (Пересечение найдено?) then (да)
      :Откатить транзакцию;
      :Вернуть 409 {error};
      stop
    else (нет)
      :Создать Booking;
      :Зафиксировать транзакцию;
      :Вернуть 201 {booking_id};
      stop
    endif
  endif
endif
@enduml

